[Unit]
Description=Reverse SSH tunnel to public server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/reverse-ssh-tunnel.env
ExecStart=/usr/local/bin/reverse-ssh-tunnel.sh /etc/reverse-ssh-tunnel.env
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
