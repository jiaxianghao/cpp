# Public Linux server with a public IP or DNS name.
SERVER_HOST=203.0.113.10
SERVER_USER=tunnel_user

# Optional private key used by the private computer to log in to the public server.
# Leave empty to use the default OpenSSH identity search path.
SSH_IDENTITY_FILE=

# Port opened on the public server side.
# 127.0.0.1 keeps the forwarded port reachable only from the public server itself.
REMOTE_BIND_ADDRESS=127.0.0.1
REMOTE_PORT=2222

# SSH service on the private computer.
LOCAL_HOST=127.0.0.1
LOCAL_PORT=22

# Keepalive settings for detecting broken networks.
SERVER_ALIVE_INTERVAL=30
SERVER_ALIVE_COUNT_MAX=3
